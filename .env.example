# ==========================================================
# Student Performance Prediction Analytics - Backend Config
# ==========================================================

# Server Host and Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Database Connection (SQLite by default, or PostgreSQL for production)
# SQLite example: sqlite:///./data/student_analytics.db
# PostgreSQL example: postgresql://username:password@host:5432/database_name
DATABASE_URL=sqlite:///./data/student_analytics.db

# CORS Allowed Origins (Comma-separated URLs of your deployed frontend)
# Example: https://your-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Authentication Secrets
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEMO_TEACHER_EMAIL=teacher@example.com
DEMO_TEACHER_PASSWORD=teacher123

# Machine Learning & Data Paths (Optional overrides)
# DATA_DIR=./data
# MODELS_DIR=./models
